# Token permanente do cliente (Ajustes > Integrações > Integração via API)
HTECH_TOKEN=pn_coloque_seu_token_aqui

# Perfil mínimo para ver o painel (um inclui os de cima):
#   ADMIN            → só administradores (padrão, se ficar vazio)
#   AGENT            → administradores e atendentes
#   RESTRICTED_AGENT → todos
PERFIL_MINIMO=ADMIN

# Opcional: IDs de usuário com acesso total (super admin), separados por vírgula.
# Entram em qualquer painel sem depender do PERFIL_MINIMO (a conta do link ainda tem que bater).
# Trate como senha: na Vercel, marque a variável como "Sensitive".
SUPER_ADMIN_IDS=

# Fuso usado para definir "hoje" (meia-noite local)
TZ_DASH=America/Sao_Paulo

# Por quantos segundos os dados da API são reaproveitados antes de buscar de novo
REFRESH_SECONDS=15

# Porta do servidor Node (só para rodar local ou em servidor próprio)
PORT=3001
